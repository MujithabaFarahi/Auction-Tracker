rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.get("auctionAdmin", false) == true;
    }

    match /config/app {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /auctionState/current {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /players/{playerId} {
        allow read: if true;
        allow create: if isAdmin() && !("contactNumber" in request.resource.data);
        allow update: if isAdmin() &&
          (!("contactNumber" in request.resource.data) ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["contactNumber"]));
        allow delete: if isAdmin();
      }

      match /playerContacts/{playerId} {
        allow get, delete: if isAdmin();
        allow create, update: if isAdmin() &&
          request.resource.data.keys().hasOnly(["contactNumber"]) &&
          request.resource.data.contactNumber is string;
      }
    }
  }
}
